// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Money rule: every amount is an integer number of TOMANS (Int). Never Decimal/Float.
// Format only at the display edge (see src/lib/format.ts).

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

// A seller/business using the platform (multi-tenant root).
// Every other table is scoped by sellerId.
model Seller {
  id        String   @id @default(cuid())
  name      String // the store's name, shown to customers
  mobile    String   @unique // normalized "09xxxxxxxxx", used to log in
  createdAt DateTime @default(now())

  // Store profile, shown on public pages (Phase 2, A6). Never the login mobile
  // unless the seller enters it as contactPhone.
  logoUrl      String?
  contactPhone String?
  instagram    String? // handle without "@"
  telegram     String? // handle without "@"

  // Card-to-card details for the customer's payment instructions (Phase 2, B6).
  // Stored ENCRYPTED with src/lib/crypto.ts, never in plain text.
  cardNumberEncrypted String?
  cardHolder          String?
  shebaEncrypted      String?

  // Which customer SMS messages this seller sends (Phase 2, B7).
  smsOnOrderPlaced Boolean @default(true)
  smsOnPaid        Boolean @default(true)
  smsOnShipped     Boolean @default(true)

  products        Product[]
  variants        ProductVariant[]
  customers       Customer[]
  orders          Order[]
  purchaseLinks   PurchaseLink[]
  memberships     Membership[]
  subscription    Subscription?
  invoices        Invoice[]
  gateway         SellerGateway?
  paymentAttempts PaymentAttempt[]
  smsMessages     SmsMessage[]
}

// One-time SMS login codes. The code itself is never stored, only its hash.
model OtpCode {
  id        String   @id @default(cuid())
  mobile    String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([mobile, createdAt])
}

// ---------------------------------------------------------------------------
// Catalog (Track A)
// ---------------------------------------------------------------------------

model Product {
  id                String   @id @default(cuid())
  sellerId          String
  seller            Seller   @relation(fields: [sellerId], references: [id])
  name              String
  price             Int // tomans
  imageUrl          String?
  category          String?
  isActive          Boolean  @default(true)
  lowStockThreshold Int      @default(3)
  createdAt         DateTime @default(now())

  variants       ProductVariant[]
  orderItems     OrderItem[]
  purchaseLinks  PurchaseLink[]

  @@index([sellerId])
}

// Color/size combination with its own stock count.
model ProductVariant {
  id        String  @id @default(cuid())
  // Denormalized from Product so SKU uniqueness can be per seller and every
  // stock query can be scoped by sellerId directly. Must equal product.sellerId.
  sellerId  String
  seller    Seller  @relation(fields: [sellerId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String?
  size      String?
  sku       String?
  stock     Int     @default(0)

  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@unique([sellerId, sku])
  @@index([productId])
}

enum StockMovementReason {
  MANUAL_ADJUSTMENT
  ORDER_PLACED
  ORDER_CANCELED
  ORDER_RETURNED
  INITIAL
}

// Audit log of every stock change (written by adjustStock).
model StockMovement {
  id        String              @id @default(cuid())
  variantId String
  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta     Int // negative = stock reduced
  reason    StockMovementReason
  note      String?
  orderId   String?
  createdAt DateTime            @default(now())

  @@index([variantId, createdAt])
}

enum CustomerTag {
  NEW
  LOYAL
  INACTIVE
}

// A customer of one seller, unique per (seller, phone).
model Customer {
  id        String      @id @default(cuid())
  sellerId  String
  seller    Seller      @relation(fields: [sellerId], references: [id])
  name      String?
  phone     String // normalized "09xxxxxxxxx"
  address   String?
  tag       CustomerTag @default(NEW)
  createdAt DateTime    @default(now())

  orders Order[]

  @@unique([sellerId, phone])
  @@index([sellerId])
}

// ---------------------------------------------------------------------------
// Sales (Track B)
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELED
  RETURNED
}

enum OrderSource {
  MANUAL
  PURCHASE_LINK
}

enum PaymentMethod {
  CARD_TO_CARD
  CASH
  OTHER
  ONLINE // through the seller's own gateway (Phase 2, B6)
}

enum ShippingStatus {
  NOT_SHIPPED
  IN_TRANSIT
  DELIVERED
  FAILED
}

model Order {
  id         String      @id @default(cuid())
  sellerId   String
  seller     Seller      @relation(fields: [sellerId], references: [id])
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  status     OrderStatus @default(PENDING_PAYMENT)
  source     OrderSource @default(MANUAL)
  totalPrice Int // tomans, computed on the server

  // Token for the customer-facing confirmation/tracking page.
  publicToken String? @unique

  // Payment
  paymentMethod    PaymentMethod?
  paidAt           DateTime?
  receiptImageUrl  String?

  // Shipping
  shippingAddress String?
  shippingMethod  String?
  shippingCost    Int?
  trackingCode    String?
  shippingStatus  ShippingStatus @default(NOT_SHIPPED)

  purchaseLinkId String?
  purchaseLink   PurchaseLink? @relation(fields: [purchaseLinkId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items           OrderItem[]
  paymentAttempts PaymentAttempt[]
  smsMessages     SmsMessage[]

  @@index([sellerId, status])
  @@index([sellerId, createdAt])
}

model OrderItem {
  id               String          @id @default(cuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  quantity         Int
  unitPrice        Int // tomans, snapshot at order time
}

// Public purchase link: /buy/[token]. Shows only the attached products.
model PurchaseLink {
  id        String    @id @default(cuid())
  sellerId  String
  seller    Seller    @relation(fields: [sellerId], references: [id])
  token     String    @unique
  title     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  products   Product[]
  orders     Order[]
  dailyViews LinkDailyView[]

  @@index([sellerId])
}

// ---------------------------------------------------------------------------
// Phase 2 (docs/phase2/README.md): team members, subscriptions, online
// payments, SMS log, purchase-link views. All created in Phase 2 Step 0.
// ---------------------------------------------------------------------------

// A person who can log in. In Phase 1 the Seller itself was the login; each
// existing Seller got a User with the same mobile and an OWNER membership.
model User {
  id        String   @id @default(cuid())
  mobile    String   @unique // normalized "09xxxxxxxxx"
  createdAt DateTime @default(now())

  memberships Membership[]
}

enum MemberRole {
  OWNER
  OPERATOR
}

model Membership {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    Seller     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  role      MemberRole
  createdAt DateTime   @default(now())

  @@unique([userId, sellerId])
  @@index([sellerId])
}

enum PlanId {
  TRIAL
  BASIC
  GROWTH
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

// One per seller. New sellers start on a 30-day TRIAL (Phase 2, A9).
model Subscription {
  id               String             @id @default(cuid())
  sellerId         String             @unique
  seller           Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  plan             PlanId             @default(TRIAL)
  status           SubscriptionStatus @default(TRIALING)
  currentPeriodEnd DateTime
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
}

model Invoice {
  id          String        @id @default(cuid())
  sellerId    String
  seller      Seller        @relation(fields: [sellerId], references: [id])
  plan        PlanId
  amount      Int // tomans
  periodStart DateTime
  periodEnd   DateTime
  status      InvoiceStatus @default(OPEN)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  paymentAttempts PaymentAttempt[]

  @@index([sellerId, createdAt])
}

enum GatewayProvider {
  ZARINPAL
  IDPAY
}

// The seller's OWN payment gateway (decision 1 in docs/phase2/README.md):
// customers' money goes straight to the seller, never through the platform.
model SellerGateway {
  id                   String          @id @default(cuid())
  sellerId             String          @unique
  seller               Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  provider             GatewayProvider
  credentialsEncrypted String // src/lib/crypto.ts; never logged or shown in full
  isActive             Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

enum PaymentAttemptStatus {
  PENDING
  VERIFIED
  FAILED
  CANCELED
}

// One trip to a gateway: for an order (seller's gateway) or a subscription
// invoice (the platform's gateway). Created before redirecting, so the
// callback URL can carry its id; `authority` is set once the gateway answers.
model PaymentAttempt {
  id            String               @id @default(cuid())
  sellerId      String
  seller        Seller               @relation(fields: [sellerId], references: [id])
  orderId       String?
  order         Order?               @relation(fields: [orderId], references: [id])
  invoiceId     String?
  invoice       Invoice?             @relation(fields: [invoiceId], references: [id])
  provider      GatewayProvider
  amount        Int // tomans; what we asked for, checked again on verify
  authority     String?              @unique
  status        PaymentAttemptStatus @default(PENDING)
  refId         String?
  cardPanMasked String?
  createdAt     DateTime             @default(now())
  verifiedAt    DateTime?

  @@index([orderId])
  @@index([invoiceId])
  @@index([sellerId, createdAt])
}

enum SmsKind {
  LOGIN_OTP
  ORDER_PLACED
  ORDER_PAID
  ORDER_SHIPPED
  PAYMENT_REMINDER
  MEMBER_INVITE
  SUBSCRIPTION_REMINDER
}

enum SmsStatus {
  SENT
  FAILED
  DEV // development: printed to the console, not sent
}

// Every SMS the platform sends (Phase 2, A8). Also the count for plan quotas.
model SmsMessage {
  id         String    @id @default(cuid())
  sellerId   String?
  seller     Seller?   @relation(fields: [sellerId], references: [id])
  to         String
  kind       SmsKind
  orderId    String?
  order      Order?    @relation(fields: [orderId], references: [id])
  status     SmsStatus
  providerId String?
  createdAt  DateTime  @default(now())

  // Each order event is texted at most once, even if an action is retried.
  // (Rows without an order have orderId NULL, which Postgres never treats as equal.)
  @@unique([orderId, kind])
  @@index([sellerId, createdAt])
}

// Purchase-link page views per day (Phase 2, B8). Counts only: no IP, no id.
model LinkDailyView {
  purchaseLinkId String
  purchaseLink   PurchaseLink @relation(fields: [purchaseLinkId], references: [id], onDelete: Cascade)
  day            DateTime     @db.Date // Tehran calendar day
  views          Int          @default(0)

  @@id([purchaseLinkId, day])
}

# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ghaltak?schema=public"

# Signs login cookies and hashes SMS codes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# Where uploaded product images are stored on disk (default: ./uploads).
# In production use a persistent volume, or swap in S3-compatible storage
# in src/server/catalog/image-storage.ts.
# UPLOAD_DIR="./uploads"

# SMS via Kavenegar (https://kavenegar.com). Optional in development:
# without these, login codes are printed to the server console.
# Required in production.
# KAVENEGAR_API_KEY=""
# KAVENEGAR_TEMPLATE=""

# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ghaltak?schema=public"

# Signs login cookies and hashes SMS codes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# Optional: a SEPARATE database for the *.int.test.ts integration tests.
# Never point this at your development database. See docs/phase1/README.md.
# TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ghaltak_test?schema=public"

# Number of reverse proxies in front of the app (default 1). The rate limits on
# the public purchase-link and receipt pages read the client IP from the entry
# that many places from the END of X-Forwarded-For, the part our own proxies
# write. PRODUCTION MUST RUN BEHIND A PROXY that appends the client address,
# e.g. nginx: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# Without one, clients can fake their IP and get around the per-IP limit.
# TRUSTED_PROXY_HOPS=1

# Optional: a SEPARATE database for the end-to-end browser test (npm run test:e2e).
# Its name must end in _e2e. Never point this at your development database.
# See e2e/README.md.
# E2E_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ghaltak_e2e?schema=public"

# Encrypts secrets we must read back (a seller's gateway credentials, card
# number, Sheba). 32 bytes, base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes those values unreadable; changing it needs a re-encryption.
SECRETS_KEY=""

# File storage (src/server/storage): "local" (default, development) or "s3".
# STORAGE_DRIVER="local"
# local: where files are kept on disk (default: ./uploads).
# UPLOAD_DIR="./uploads"
# s3: any S3-compatible service inside Iran (ArvanCloud, Liara). Both buckets
# stay PRIVATE; the app serves files itself.
# S3_ENDPOINT=""
# S3_REGION="default"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET_PUBLIC=""     # product images, store logos
# S3_BUCKET_PRIVATE=""    # payment receipts

# The app's public address, e.g. "https://ghaltak.ir" (no trailing slash).
# Payment gateways send customers back to APP_URL/pay/callback/... (B6).
# REQUIRED in production (online payment refuses to start without it). In
# development it is taken from the request when unset.
# APP_URL=""

# Subscriptions (Phase 2, A9): charging stays off until prices are validated
# with the pilot sellers (docs/phase2/README.md, decision 4).
# BILLING_ENABLED="false"
# The platform's OWN gateway, for subscription payments only. Customers'
# order payments use each seller's own gateway (decision 1).
# PLATFORM_GATEWAY_PROVIDER="ZARINPAL"
# PLATFORM_GATEWAY_MERCHANT_ID=""

# SMS via Kavenegar (https://kavenegar.com), src/server/sms. Optional in
# development: without a key, messages (login codes too) are printed to the
# server console and recorded as DEV. Required in production: without it every
# SMS fails, so nobody can log in (codes are never printed in production).
# KAVENEGAR_API_KEY=""
# One approved "verify/lookup" template per message kind. A kind without a
# template is recorded as FAILED. Template texts: docs/phase2/DEPLOY.md (C3).
# KAVENEGAR_TEMPLATE=""                        # login code (LOGIN_OTP)
# KAVENEGAR_TEMPLATE_ORDER_PLACED=""
# KAVENEGAR_TEMPLATE_ORDER_PAID=""
# KAVENEGAR_TEMPLATE_ORDER_SHIPPED=""
# KAVENEGAR_TEMPLATE_PAYMENT_REMINDER=""
# KAVENEGAR_TEMPLATE_MEMBER_INVITE=""
# KAVENEGAR_TEMPLATE_SUBSCRIPTION_REMINDER=""
